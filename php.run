'./configure' '--prefix=/my' '--exec-prefix=/my' '--with-apxs2=/my/bin/apxs' '--enable-ftp' '--with-mysqli' '--enable-mbstring' '--enable-gd' 'LIBXML_CFLAGS=-I/my/include/libxml2' 'LIBXML_LIBS=-L/my/lib -lxml2' 'SQLITE_CFLAGS=-I/my/inlude' 'SQLITE_LIBS=-L/my/lib -lsqlite3' 'PNG_CFLAGS=-I/my/include/libpng16' 'PNG_LIBS=-L/my/lib -lpng16' 'ONIG_CFLAGS=-I/my/include' 'ONIG_LIBS=-L/my/lib -lonig' --with-openssl --with-zlib --enable-bcmath --enable-calendar --enable-dba --enable-dl-test --with-mysqli --with-mysql-sock --enable-pcntl --enable-shmop --enable-soap --enable-sockets --enable-sysvmsg --enable-sysvsem --enable-sysvshm --with-curl CURL_CFLAGS="-I/my/include" CURL_LIBS="-L/my/lib -lcurl" --with-expat --enable-zend-test --enable-mysqlnd --enable-zend-max-execution-timers --with-zip --enable-fpm --with-fpm-acl --with-fpm-selinux --enable-phpdbg --enable-gcov --enable-zts --enable-sigchild --enable-libgcc --enable-werror --enable-undefined-sanitize